{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "AllowedHosts": "*",
  "FrontendSettings": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://localhost:3000",
      "https://localhost:4200"
    ]
  },
  "JWT": {
    "ValidIssuer": "https://localhost:5048",
    "ValidAudience": "https://localhost:4200",
    "LifeSpanInDays": 7
  },
  "SmtpSettings": {
    "Server": "smtp.gmail.com",
    "Port": 587,
    "SecureSocketOptions": "StartTls",
    "EnableSsl": true
  },
  "AppBaseUrl": "https://localhost:5048",
  "MongoDbSettings": {
    "DatabaseName": "CinephoriaDashboardDB_Dev"
  },
  "ConnectionStrings": {
    "PostgreSQL": "Host=localhost;Port=5432;Database=CinephoriaDB_Dev;Include Error Detail=true"
  },
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://*:5048",
        "Certificate": {
          "Path": "./certificates/dev-cert.pfx",
          "Password": "REPLACE_WITH_CERT_PASSWORD"
        }
      },
      "Http": {
        "Url": "http://*:5080"
      }
    }
  },
  "TMDbSettings": {
    "BaseUrl": "https://api.themoviedb.org/3",
    "ImageBaseUrl": "https://image.tmdb.org/t/p/original",
    "DefaultLanguage": "fr-FR"
  },
  "FeatureFlags": {
    "EnableSwagger": true,
    "EnableDetailedErrors": true,
    "EnableDeveloperExceptionPage": true,
    "EnableMigrations": true
  },
  "CorsSettings": {
    "AllowedOrigins": [
      "https://localhost:4200",
      "https://localhost:3000",
      "http://localhost:4200",
      "http://localhost:3000"
    ],
    "AllowedMethods": [ "GET", "POST", "PUT", "DELETE", "OPTIONS" ],
    "AllowedHeaders": [ "*" ],
    "AllowCredentials": true
  }
}