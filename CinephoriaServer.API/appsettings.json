{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FrontendSettings": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://localhost:4200"
    ]
  },
  "JWT": {
    "ValidIssuer": "https://localhost:5048",
    "ValidAudience": "https://localhost:4200",
    "LifeSpanInDays": 3,
    "Secret": "DEFAULT_SECRET_KEY_REPLACE_IN_ENV_VARIABLES"
  },
  "SmtpSettings": {
    "Server": "smtp.gmail.com",
    "Port": 587,
    "Username": "default-cinephoria@example.com",
    "Password": "DEFAULT_SMTP_PASSWORD_REPLACE_IN_ENV_VARIABLES",
    "SecureSocketOptions": "StartTls"
  },
  "AppBaseUrl": "https://localhost:5048",
  "MongoDbSettings": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "CinephoriaDashboardDB"
  },
  "ConnectionStrings": {
    "PostgreSQL": "Host=localhost;Port=5432;Database=CinephoriaDB;Username=postgres;Password=password;Include Error Detail=true"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5048"
      }
    }
  },
  "TMDbSettings": {
    "ApiKey": "DEFAULT_TMDB_API_KEY_REPLACE_IN_ENV_VARIABLES",
    "BaseUrl": "https://api.themoviedb.org/3",
    "ImageBaseUrl": "https://image.tmdb.org/t/p/original",
    "DefaultLanguage": "fr-FR"
  },
  "FeatureFlags": {
    "EnableSwagger": false,
    "EnableDetailedErrors": false,
    "EnableDeveloperExceptionPage": false,
    "EnableMigrations": false
  },
  "CorsSettings": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://localhost:4200"
    ],
    "AllowedMethods": [ "GET", "POST", "PUT", "DELETE", "OPTIONS" ],
    "AllowedHeaders": [ "*" ],
    "AllowCredentials": true
  }
}
