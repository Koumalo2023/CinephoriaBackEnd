{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Error",
      "Microsoft.EntityFrameworkCore.Database.Command": "Error"
    }
  },
  "AllowedHosts": "*.cinephoria.eu",
  "FrontendSettings": {
    "AllowedOrigins": [
      "https://www.cinephoria.eu",
      "https://cinephoria.eu"
    ]
  },
  "JWT": {
    "ValidIssuer": "https://api.cinephoria.eu",
    "ValidAudience": "https://www.cinephoria.eu",
    "LifeSpanInDays": 1
  },
  "SmtpSettings": {
    "Server": "smtp.gmail.com",
    "Port": 587,
    "Username": "REPLACE_WITH_PRODUCTION_SMTP_USERNAME",
    "Password": "REPLACE_WITH_PRODUCTION_SMTP_PASSWORD",
    "SecureSocketOptions": "StartTls",
    "EnableSsl": true
  },
  "AppBaseUrl": "https://api.cinephoria.eu",
  "MongoDbSettings": {
    "ConnectionString": "REPLACE_WITH_PRODUCTION_MONGODB_CONNECTION_STRING",
    "DatabaseName": "CinephoriaDashboardDB"
  },
  "ConnectionStrings": {
    "PostgreSQL": "REPLACE_WITH_PRODUCTION_POSTGRESQL_CONNECTION_STRING"
  },
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://*:443",
        "Certificate": {
          "Path": "/etc/ssl/certs/cinephoria-production.pfx",
          "Password": "REPLACE_WITH_PRODUCTION_CERT_PASSWORD"
        }
      }
    }
  },
  "TMDbSettings": {
    "ApiKey": "REPLACE_WITH_PRODUCTION_TMDB_API_KEY",
    "BaseUrl": "https://api.themoviedb.org/3",
    "ImageBaseUrl": "https://image.tmdb.org/t/p/original",
    "DefaultLanguage": "fr-FR"
  },
  "FeatureFlags": {
    "EnableSwagger": false,
    "EnableDetailedErrors": false,
    "EnableDeveloperExceptionPage": false,
    "EnableMigrations": false
  },
  "CorsSettings": {
    "AllowedOrigins": [
      "https://www.cinephoria.eu",
      "https://cinephoria.eu"
    ],
    "AllowedMethods": [ "GET", "POST", "PUT", "DELETE", "OPTIONS" ],
    "AllowedHeaders": [ "*" ],
    "AllowCredentials": true
  },
  "HealthChecks": {
    "Enabled": true,
    "Endpoint": "/health",
    "Timeout": "00:00:30"
  },
  "RateLimiting": {
    "Enabled": true,
    "MaxRequestsPerMinute": 100,
    "MaxRequestsPerHour": 1000
  },
  "Security": {
    "RequireHttps": true,
    "HstsMaxAge": 31536000,
    "ContentSecurityPolicy": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline';"
  }
}