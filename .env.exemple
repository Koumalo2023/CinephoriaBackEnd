# PostgreSQL Connection String
ConnectionStrings__PostgreSQL=Host=localhost;Database=cinephoriaapp-db;Username=votre_utilisateur;Password=votre_mot_de_passe

# MongoDB Connection String
ConnectionStrings__MongoDB=mongodb://votre_utilisateur_mongo:votre_mot_de_passe_mongo@localhost:27017/cinephoria

# JWT Configuration
JWT__Secret=votre_secret_jwt_super_securise_minimum_32_caracteres
JWT__Issuer=CinephoriaAPI
JWT__Audience=CinephoriaClients
JWT__ExpirationInMinutes=60

# TMDB API Configuration
TMDB__ApiKey=votre_cle_api_tmdb_ici
TMDB__BaseUrl=https://api.themoviedb.org/3

# SMTP Configuration (optionnel pour développement)
SMTP__Host=smtp.gmail.com
SMTP__Port=587
SMTP__Username=votre_email@gmail.com
SMTP__Password=votre_mot_de_passe_application
SMTP__EnableSsl=true
SMTP__FromEmail=noreply@cinephoria.com
SMTP__FromName=Cinephoria

# Certificate Configuration
Certificates__Development=./certificates/dev-cert.pfx
Certificates__Password=votre_mot_de_passe_certificat

# Application Settings
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=https://localhost:5001;http://localhost:5000

# Database Configuration
DB_USER=prodUser
DB_PASSWORD=votre_mot_de_passe_db
DB_NAME=cinephoriaapp-db

# MongoDB Configuration
MONGO_USER=admin
MONGO_PASSWORD=votre_mot_de_passe_mongo

# Vault Configuration (si utilisé)
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=votre_token_vault

# Logging Configuration
Serilog__MinimumLevel__Default=Information
Serilog__WriteTo__0__Name=Console
Serilog__WriteTo__1__Name=File
Serilog__WriteTo__1__Args__path=logs/CinephoriaLog-.txt
Serilog__WriteTo__1__Args__rollingInterval=Day

# Security Settings
AllowedHosts=*
Cors__AllowedOrigins=https://localhost:4200,http://localhost:4200

# Rate Limiting
RateLimit__PermitLimit=100
RateLimit__Window=60
RateLimit__QueueLimit=0

# Cache Settings
Redis__ConnectionString=localhost:6379
Cache__TimeoutInMinutes=30